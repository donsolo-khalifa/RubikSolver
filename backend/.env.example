# Copy this file to .env and edit it. Values set in the shell override this file.

# Webcam index (find Iriun's with: python tools/list_cameras.py) or a path to a video file.
CAMERA_SOURCE=0

# Set to 1 if Iriun mirrors the picture.
FLIP_HORIZONTAL=0

# Loop a video-file source instead of stopping at its end.
LOOP_VIDEO=1

# Requested camera resolution.
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Blur threshold for auto-capture; tune on recorded video.
MIN_SHARPNESS=10

# Your cube's colours when held for the first scan (U = top, F = facing the camera,
# R = right, L = left, B = back, D = bottom). W Y R O G B = white yellow red orange green blue.
# Standard cubes: U=W,R=R,F=G,D=Y,L=O,B=B (the default).
COLOR_SCHEME=U=W,R=R,F=G,D=Y,L=O,B=B
